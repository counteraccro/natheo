<!DOCTYPE html>
<html lang="{{ locale|default(app.request.locale) }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {% block meta %}{% endblock %}
    <title>{% block title %}{{ 'front.page.title'|trans({}, 'front', locale|default(null)) }}{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('assets/natheo/favico/favicon.svg') }}">
    <link rel="icon" type="image/x-icon" href="{{ asset('assets/natheo/favico/favicon.ico') }}" sizes="any">
    <script>
        {# Même règle que useColorScheme(), appliquée avant le rendu pour éviter un flash du thème clair #}
        try {
            var theme = localStorage.getItem('frontColorScheme');
            if (theme === 'dark' || (theme !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
        } catch (e) {}
    </script>

    {% block stylesheets %}
        {{ vite_entry_link_tags(scriptsTag) }}
    {% endblock %}

    {% block javascripts %}
        {{ vite_entry_script_tags(scriptsTag) }}
    {% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
{% block body %}{% endblock %}
</body>
</html>
