<!DOCTYPE html>
<html lang="{{ locale|default(app.request.locale) }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {% block meta %}{% endblock %}
    <title>{% block title %}{{ 'front.page.title'|trans({}, 'front', locale|default(null)) }}{% endblock %}</title>
    <link rel="icon" type="image/x-icon" href="{{ asset('assets/natheo/favico/favicon.ico') }}">
    <script>
        {# Appliqué avant le rendu pour éviter un flash du thème clair #}
        try {
            if (localStorage.getItem('theme') === 'dark') {
                document.documentElement.classList.add('dark');
            }
        } catch (e) {}
    </script>

    {% block stylesheets %}
        {{ vite_entry_link_tags(scriptsTag) }}
    {% endblock %}

    {% block javascripts %}
        {{ vite_entry_script_tags(scriptsTag) }}
    {% endblock %}
</head>
<body class="bg-theme-1-50">
<div class="container px-6 py-8 mx-auto">
{% block body %}{% endblock %}
</div>
</body>
</html>
