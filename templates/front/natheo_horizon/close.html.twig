{% extends 'front/front_base.html.twig' %}

{% block title %}
    {{ 'front_error.closed_site.title'|trans({}, 'front_error', locale) }}
{% endblock %}

{% block body_class %}bg-night text-on-night{% endblock %}

{% block body %}
    <main class="mx-auto flex min-h-screen w-full max-w-page flex-col justify-center px-5 py-16 [--focus:var(--focus-on-night)]">
        {# Logo du thème, même grille que Layout/BrandLogo.vue #}
        <svg class="size-14" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <rect x="4" y="4" width="56" height="17" rx="3" fill="#c9b8ff"/>
            <rect x="4" y="24" width="26.5" height="17" rx="3" fill="#8f6cff"/>
            <rect x="33.5" y="24" width="26.5" height="17" rx="3" fill="#8f6cff"/>
            <rect x="4" y="44" width="16.6" height="16" rx="3" fill="#6a45ec"/>
            <rect x="23.7" y="44" width="16.6" height="16" rx="3" fill="#6a45ec"/>
            <rect x="43.4" y="44" width="16.6" height="16" rx="3" fill="#5cc8f0"/>
        </svg>
        <h1 class="mt-10 max-w-[16ch] text-[clamp(2.4rem,5.2vw,4.25rem)] leading-[1.02]">
            {{ 'front_error.closed_site.block_title'|trans({}, 'front_error', locale) }}
        </h1>
        <p class="mt-6 max-w-[60ch] text-lg text-on-night-muted">
            {{ 'front_error.closed_site.block_text'|trans({}, 'front_error', locale) }}
        </p>
        <p class="mt-10">
            <a href="{{ path('admin_dashboard_index') }}" class="text-on-night-muted">
                {{ 'front_error.closed_site.admin_link'|trans({}, 'front_error', locale) }}
            </a>
        </p>
    </main>
{% endblock %}
