{% extends 'front/front_base.html.twig' %}

{% block title %}
    {{ 'front_error.closed_site.title'|trans({}, 'front_error', locale) }}
{% endblock %}

{% block body_class %}bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100{% endblock %}

{% block body %}
    <main class="max-w-2xl mx-auto mt-24 px-6 text-center">
        <h1 class="text-2xl font-semibold">{{ 'front_error.closed_site.block_title'|trans({}, 'front_error', locale) }}</h1>
        <p class="mt-4">{{ 'front_error.closed_site.block_text'|trans({}, 'front_error', locale) }}</p>
        <a href="{{ path('admin_dashboard_index') }}" class="inline-block mt-8 text-sm underline">{{ 'front_error.closed_site.admin_link'|trans({}, 'front_error', locale) }}</a>
    </main>
{% endblock %}
