<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="">
<head>
    <meta charset="UTF-8">
    {% include "/admin/includes/theme_init.html.twig" %}
    {# Le bloc title est déjà échappé par la page : |raw évite un double échappement après |trim #}
    {% set pageTitle = block('title') is defined ? block('title')|trim : '' %}
    <title>{{ pageTitle|raw }}{{ pageTitle is not empty ? ' – ' }}{{ get_option_system_value_by_key(os_site_name) }}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('assets/natheo/favico/favicon.svg') }}">
    <link rel="icon" type="image/x-icon" href="{{ asset('assets/natheo/favico/favicon.ico') }}" sizes="any">
    {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
    {% block stylesheets %}

        {%set theme = get_option_user_value_by_key(ou_theme_site) %}
        {{ vite_entry_link_tags('admin_css') }}
    {% endblock %}

    {% block javascripts %}
        {{ vite_entry_script_tags('admin') }}
    {% endblock %}
</head>
<body>
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileSidebar()"></div>

<div class="flex h-screen overflow-hidden">

    <!-- Sidebar  -->
    {% include "/admin/includes/menu.html.twig" %}
    <!-- Page Content  -->
    <div class="flex-1 flex flex-col overflow-hidden">
        {% include "/admin/includes/header.html.twig" %}
        <main class="relative flex-1 overflow-y-auto p-4 sm:p-6">
            {% block body %}{% endblock %}
        </main>
    </div>
    {% include "/admin/includes/debug_bar.html.twig" %}
</div>
    <div {{ vue_component('Admin/Global/ToastContainer') }}></div>
    {% include "/admin/includes/ui_translate.html.twig" %}
    {% include "/admin/includes/scripts.html.twig" %}

<script>
    {% block scriptJavascript %}

    {% endblock %}
</script>

</body>
</html>
