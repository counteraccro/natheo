{% extends 'admin/admin_base.html.twig' %}

{% block title %}{{ 'advanced_options.index.title' | trans({}, 'advanced_options') }}{% endblock %}

{% block body %}

    <twig:Admin:PageHeaderComponent :breadcrumb="breadcrumb" :title="'advanced_options.index.title' | trans({}, 'advanced_options')" :description="'advanced_options.index.description' | trans({}, 'advanced_options')">
        <twig:block name="icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="m8 8-4 4 4 4m8 0 4-4-4-4m-2-3-4 14"></path>
            </svg>
        </twig:block>
    </twig:Admin:PageHeaderComponent>

    <div {{ vue_component('Admin/Tools/AdvancedOptions/AdvancedOptions', {
        'urls' : urls,
        'translate' : translate,
        'data' : data,
        'csrfTokens': {
            'switch_env': csrf_token('switch_env'),
            'reset_data': csrf_token('reset_data'),
            'reset_database': csrf_token('reset_database')
        }
    }) }}>
    </div>

{% endblock %}
