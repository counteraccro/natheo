{% extends 'admin/admin_base.html.twig' %}


{% if id is same as null %}
    {% set title = 'sql_manager.add.page_title_h1' | trans({}, 'sql_manager') %}
    {% set description = 'sql_manager.add.description' | trans({}, 'sql_manager') %}
{% elseif isExecute %}
    {% set title = 'sql_manager.execute.page_title' | trans({'id' : id}, 'sql_manager') %}
    {% set description = 'sql_manager.execute.description' | trans({}, 'sql_manager') %}
{% else %}
    {% set title = 'sql_manager.update.page_title' | trans({'id' : id}, 'sql_manager') %}
    {% set description = 'sql_manager.update.description' | trans({}, 'sql_manager') %}
{% endif %}

 {% block title %}
     {{ title }}
 {% endblock %}

{% block body %}

    <twig:Admin:PageHeaderComponent :breadcrumb="breadcrumb" :title="title" :description="description">
        <twig:block name="icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="m8 9 3 3-3 3m5 0h3M4 19h16a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Z"></path>
            </svg>
        </twig:block>
    </twig:Admin:PageHeaderComponent>

    <div {{ vue_component('Admin/Tools/SqlManager', {
        'urls' : urls,
        'translate' : translate,
        'isExecute' : isExecute,
        'schema' : schema
    }) }}>
    </div>

{% endblock %}