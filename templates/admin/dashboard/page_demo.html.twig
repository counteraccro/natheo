{% block body %}

    {{ breadcrumb(breadcrumb) }}

    <h1 class="head-title">{{ 'pagedemo.page_title_h1' | trans }}</h1>

    {# Page d'origine de l'exemple de surcharge : normalement remplacée via config/cms/overwrite.yaml #}
