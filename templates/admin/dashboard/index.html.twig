{% extends 'admin/admin_base.html.twig' %}

{% block title %}{{ 'dashboard.index.title' | trans({}, 'dashboard') }}{% endblock %}

{% block body %}

    <twig:Admin:PageHeaderComponent :title="'dashboard.index.title' | trans({}, 'dashboard')" :description="'dashboard.index.description' | trans({}, 'dashboard')">
        <twig:block name="icon">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="m4 12 8-8 8 8M6 10.5V19a1 1 0 0 0 1 1h3v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h3a1 1 0 0 0 1-1v-8.5"/>
            </svg>
        </twig:block>
    </twig:Admin:PageHeaderComponent>

    {% if roles.isContributeur %}
        <div {{ vue_component('Admin/Dashboard/DashboardStatistics', {
            'translate' : translateStat,
            'urls' : urlStat,
            'roles' : roles,
        }) }}>
        </div>
    {% endif %}

    <div {{ vue_component('Admin/Dashboard/Dashboard', {
        'urls' : urls,
        'translate' : translate,
        'datas' : datas,
        'roles' : roles,
        'csrf_tokens' : {'update_user_data' : csrf_token(csrfTokenUpdateUserData)},
    }) }}>
    </div>
{% endblock %}