{% extends 'admin/admin_base.html.twig' %}

{% block title %}{{ 'dashboard.index' | trans({}, 'dashboard') }}{% endblock %}

{% block body %}

    {% if roles.isContributeur %}
        <div {{ vue_component('Admin/Dashboard/DashboardStatistics', {
            'translate' : translateStat,
            'urls' : urlStat,
            'roles' : roles,
        }) }}>
        </div>
    {% endif %}

    <div {{ vue_component('Admin/Dashboard/Dashboard', {
        'urls' : urls,
        'translate' : translate,
        'datas' : datas,
        'roles' : roles,
    }) }}>
    </div>

    <div id="unit-test" class="hidden">{{ 'dashboard.index' | trans({}, 'dashboard') }}</div>
{% endblock %}

{% block scriptJavascript %}
setPageTitle('{{ 'dashboard.index' | trans({}, 'dashboard') }}')
{% endblock %}