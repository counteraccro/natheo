{# Thème et mode sombre appliqués dans le <head>, avant le premier rendu, pour éviter le flash du mode clair #}
<script id="theme-init">
    (function () {
        const root = document.documentElement;
        root.classList.add('no-transition');
        try {
            const theme = localStorage.getItem('theme') || 'violet';
            if (theme !== 'violet') {
                root.setAttribute('data-theme', theme);
            }
            if (localStorage.getItem('darkMode') === 'dark') {
                root.setAttribute('data-theme-mode', 'dark');
                root.classList.add('dark');
            }
        } catch (e) {
            // localStorage indisponible : thème par défaut
        }
        // Transitions réactivées après le premier rendu, pour les seuls changements faits par l'utilisateur
        window.addEventListener('load', function () {
            requestAnimationFrame(function () {
                root.classList.remove('no-transition');
            });
        });
    })();
</script>
