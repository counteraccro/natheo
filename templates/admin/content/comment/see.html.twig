{% extends 'admin/admin_base.html.twig' %}

{% block title %}{{ 'comment.see.page_title' | trans({'%id%' : datas.id}, 'comment') }}{% endblock %}

{% block body %}

    <twig:Admin:PageHeaderComponent :breadcrumb="breadcrumb" :title="'comment.see.page_title_h1' | trans({'%id%' : datas.id}, 'comment')">
        <twig:block name="icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
            </svg>
        </twig:block>
    </twig:Admin:PageHeaderComponent>



    <div class="mt-5" {{ vue_component('Admin/Content/Comment/CommentEdit', {'urls' : urls, 'translate' : translate, 'datas' : datas, 'csrf_token_save' : csrf_token(csrfTokenSave)}) }}></div>
{% endblock %}