{% extends 'admin/admin_base.html.twig' %}

{% block title %}{{ 'api_token.doc.title' | trans({}, 'api_token') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/apiplatform/swagger-ui/swagger-ui.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/apiplatform/swagger-ui/swagger-ui-bundle.js') }}" defer></script>
    <script src="{{ asset('bundles/apiplatform/swagger-ui/swagger-ui-standalone-preset.js') }}" defer></script>
    <script src="{{ asset('bundles/apiplatform/init-swagger-ui.js') }}" defer></script>
{% endblock %}

{% block body %}

    <twig:Admin:PageHeaderComponent :breadcrumb="breadcrumb" :title="'api_token.doc.title' | trans({}, 'api_token')" :description="'api_token.doc.description' | trans({}, 'api_token')">
        <twig:block name="icon">
            <svg fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 3v4a1 1 0 0 1-1 1H5m5 4-2 2 2 2m4-4 2 2-2 2m5-12v16a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7.914a1 1 0 0 1 .293-.707l3.914-3.914A1 1 0 0 1 9.914 3H18a1 1 0 0 1 1 1Z"/>
            </svg>
        </twig:block>
    </twig:Admin:PageHeaderComponent>

    {# json_encode(65) : JSON_UNESCAPED_SLASHES | JSON_HEX_TAG, aucune balise ne peut fermer le script #}
    <script id="swagger-data" type="application/json">{{ swaggerData | json_encode(65) | raw }}</script>
    <div class="card p-2">
        <div id="swagger-ui"></div>
    </div>

{% endblock %}
