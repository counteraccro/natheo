{% extends 'admin/admin_base.html.twig' %}

{% block title %}{{ 'user.add.title' | trans({}, 'user') }}{% endblock %}

{% block body %}

    <twig:Admin:PageHeaderComponent :breadcrumb="breadcrumb" :title="'user.add.title' | trans({}, 'user')" :description="'user.add.description' | trans({}, 'user')">
        <twig:block name="icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
        </twig:block>
    </twig:Admin:PageHeaderComponent>

    {{ form_start(form) }}
    <div class="card mb-4">
        <div class="card-header">
            <div>
                <div class="card-title">
                    <svg
                        class="card-icon"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        fill="none"
                        viewBox="0 0 24 24"
                        style="color: var(--primary)"
                    >
                        <path
                            stroke="currentColor"
                            stroke-width="2"
                            d="M7 17v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-4a3 3 0 0 0-3 3Zm8-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                        />
                    </svg>
                    {{ 'user.add.profile' | trans({}, 'user') }}
                </div>
                <p class="card-subtitle">
                    {{ 'user.add.profile_description' | trans({}, 'user') }}
                </p>
            </div>
        </div>
        <div class="p-5">
            <div class="form-group">
                <label class="form-label">{{ field_label(form.email) }}</label>
                <input type="email" class="form-input" value="{{ field_value(form.email) }}"
                       placeholder="{{ field_label(form.email) }}" required
                       id="{{ field_id(form.email) }}" name="{{ field_name(form.email) }}">
                <span class="form-text">{{ field_help(form.email) }}</span>
            </div>

            <div class="form-group">
                <label class="form-label">{{ field_label(form.roles) }}</label>
                <select class="form-input" id="{{ field_id(form.roles) }}" name="{{ field_name(form.roles) }}">
                    {% for label, value in field_choices(form.roles) %}
                        <option value="{{ value }}">{{ label }}</option>
                    {% endfor %}
                </select>
                <span class="form-text">{{ field_help(form.roles) }}</span>
            </div>

        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <div>
                <div class="card-title">
                    <svg
                        class="card-icon"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        fill="none"
                        viewBox="0 0 24 24"
                        style="color: var(--primary)"
                    >
                        <path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="2" d="M10 19H5a1 1 0 0 1-1-1v-1a3 3 0 0 1 3-3h2m10 1a3 3 0 0 1-3 3m3-3a3 3 0 0 0-3-3m3 3h1m-4 3a3 3 0 0 1-3-3m3 3v1m-3-4a3 3 0 0 1 3-3m-3 3h-1m4-3v-1m-2.121 1.879-.707-.707m5.656 5.656-.707-.707m-4.242 0-.707.707m5.656-5.656-.707.707M12 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                    </svg>
                    {{ 'user.add.personal_data' | trans({}, 'user') }}
                </div>
                <p class="card-subtitle">
                    {{ 'user.add.personal_data_description' | trans({}, 'user') }}
                </p>
            </div>
        </div>
        <div class="p-5 pb-13">
            <div class="form-group">
                <label class="form-label">{{ field_label(form.login) }}</label>
                <input type="text" class="form-input" value="{{ field_value(form.login) }}"
                       placeholder="{{ field_label(form.login) }}"
                       id="{{ field_id(form.login) }}" name="{{ field_name(form.login) }}">
                <span class="form-text">{{ field_help(form.login) }}</span>
            </div>

            <div class="form-group">
                <label class="form-label">{{ field_label(form.firstname) }}</label>
                <input type="text" class="form-input" value="{{ field_value(form.firstname) }}"
                       placeholder="{{ field_label(form.firstname) }}"
                       id="{{ field_id(form.firstname) }}" name="{{ field_name(form.firstname) }}">
                <span class="form-text">{{ field_help(form.firstname) }}</span>
            </div>

            <div class="form-group">
                <label class="form-label">{{ field_label(form.lastname) }}</label>
                <input type="text" class="form-input" value="{{ field_value(form.lastname) }}"
                       placeholder="{{ field_label(form.lastname) }}"
                       id="{{ field_id(form.lastname) }}" name="{{ field_name(form.lastname) }}">
                <span class="form-text">{{ field_help(form.lastname) }}</span>
            </div>
        </div>
    </div>



    <div class="card mb-4">
        <div class="card-header">
            <div>
                <div class="card-title">
                    <svg
                        class="card-icon"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        fill="none"
                        viewBox="0 0 24 24"
                        style="color: var(--primary)"
                    >
                        <path
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                        />
                    </svg>
                    {{ 'user.add.information' | trans({}, 'user') }}
                </div>
                <p class="card-subtitle">
                    {{ 'user.add.information_description' | trans({}, 'user') }}
                </p>
            </div>
        </div>
        <div class="p-5">
            <div class="text-sm text-fg-muted">

                <p class="mb-2">{{ 'user.add.information_role_info' | trans({}, 'user') }}</p>

                {{ 'user.add.information_list_role' | trans({}, 'user') }}
                <ul class="list-inside list-disc mt-2 ms-2">
                    <li><b>{{ 'user.add.information_role_user' | trans({}, 'user') }}</b>
                        : {{ 'user.add.information_role_user_info' | trans({}, 'user') }}</li>
                    <li><b>{{ 'user.add.information_role_contributor' | trans({}, 'user') }}</b>
                        : {{ 'user.add.information_role_contributor_info' | trans({}, 'user') }}</li>
                    <li><b>{{ 'user.add.information_role_admin' | trans({}, 'user') }}</b>
                        : {{ 'user.add.information_role_admin_info' | trans({}, 'user') }}</li>
                    <li><b>{{ 'user.add.information_role_super_admin' | trans({}, 'user') }}</b>
                        : {{ 'user.add.information_role_super_admin_info' | trans({}, 'user') }}</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-5">
        <a href="{{ path('admin_user_index') }}" class="btn btn-sm btn-outline-dark">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            {{ 'user.form.back' | trans({}, 'user') }}
        </a>
        {{ form_widget(form.save) }}
    </div>
    {{ form_end(form) }}

{% endblock %}