{% extends 'installation/installation_base.html.twig' %}
{% block title %}
    {{ 'installation.step.0.titre' | trans({}, 'installation') }}
{% endblock %}

{% block body %}

    <div {{ vue_component('Installation/InstallationStepper', {
        'currentStep' : 'step-0',
        'steps' : allSteps
    }) }}></div>

    <h2 class="text-2xl font-bold mb-2">
        {{ 'installation.step.0.h2.title' | trans({}, 'installation') }}
    </h2>
    <p class="text-sm mb-6" style="color: var(--text-secondary);">
        {{ 'installation.step.0.h2.sub.title' | trans({}, 'installation') }}
    </p>

    <div class="card mb-4">
        <div class="card-header" style="background-color: var(--primary);">
            <div class="card-title" style="color: #FFFFFF">
                <svg class="card-icon" style="color: #FFFFFF" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-width="2"
                        d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                </svg>
                {{ 'installation.step.0.card.title' | trans({}, 'installation') }}
            </div>
        </div>
        <div class="p-5">
            <div class="check-item">
                <span class="text-sm font-medium"> {{ 'installation.step.0.php.version' | trans({}, 'installation') }} ({{ requirement.php_required_constraint }})</span>

                {% if requirement.is_compatible %}
                <span class="check-badge success">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    {{ requirement.php_current_version }}
                </span>
                {% else %}
                    <span class="check-badge danger">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18 17.94 6M18 18 6.06 6"></path></svg>
                   {{ requirement.php_current_version }}
                </span>
                {% endif %}
            </div>
        </div>
    </div>

{% endblock %}