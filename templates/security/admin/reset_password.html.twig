{% extends 'admin/auth_base.html.twig' %}

{% block title %}{{ 'user.login_user.title' | trans({}, 'user') }}{% endblock %}

{% block body %}
    <section id="auth-form" class="bg-gray-50 dark:bg-gray-900">

        <div class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0">
            <div class="w-full bg-white rounded-lg shadow-sm dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">

                <div class="logo-container text-center mt-8">
                    <twig:BrandLogo class="logo"/>
                    <h1 class="text-fg" style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem"> {{ get_option_system_value_by_key(os_site_name)}}</h1>
                    <p class="text-fg-muted" style="font-size: 0.875rem">{{ 'user.reset_password.title' | trans({}, 'user') }}</p>
                </div>

                <div class="p-4 space-y-4 md:space-y-6 sm:p-8">

                    {% if msg is not same as("") %}
                        <div class="alert alert-primary-light">
                            <svg class="alert-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <div class="alert-content">
                                <div class="alert-title">{{ 'user.login.always_log_title'|trans({}, 'user') }}</div>
                                <div class="alert-message">
                                    {{ msg }}
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <form class="space-y-4 md:space-y-6" method="POST">
                        <div>
                            <label for="email" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">{{ 'user.login_user.email' | trans({}, 'user') }}</label>
                            <input type="email" name="email" id="email" value="" class="form-input" placeholder="name@company.com" required="">
                        </div>
                        <div class="flex items-center justify-between">

                            <a href="{{ path('auth_user_login') }}" class="text-sm link"> {{ 'user.change_password.link_login' | trans({}, 'user') }}</a>
                            <a href="{{ path('front_no_local') }}" class="text-sm link"> {{ 'user.change_password.link_home' | trans({}, 'user') }}</a>
                        </div>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        <button type="submit" class="btn btn-primary btn-md w-full">
                            {{ 'user.reset_password.submit' | trans({}, 'user') }}
                        </button>
                    </form>
                </div>
            </div>
            <p class="text-center text-sm mt-6 text-fg-muted">
                {{ 'global.footer.licence'|trans({'year': 'now' | date('Y')}, 'global') | raw }}
            </p>
        </div>
    </section>
{% endblock %}
