{% set site_name = get_option_system_value_by_key(os_site_name) %}
{% set site_url = get_option_system_value_by_key(os_adresse_site) %}
{% apply inky_to_html|inline_css(vite_entry_css_source('email')) %}
<table role="presentation" class="email-wrapper" width="100%" bgcolor="#f3f4f6" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td align="center" style="padding:32px 16px;">
            <table role="presentation" class="email-container" width="600" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td class="email-header" align="left">
                        <a href="{{ site_url }}" style="text-decoration:none;">
                            <span class="email-logo">{{ site_name|first|upper }}</span>
                            <span class="email-site-name">{{ site_name }}</span>
                        </a>
                    </td>
                </tr>
                <tr>
                    <td class="email-card" bgcolor="#ffffff">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td class="email-body">
                                    {% block body %}{% endblock %}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td class="email-footer">
                        <p>{{ 'mail.template.footer'|trans({'site': '<a href="' ~ site_url|e('html_attr') ~ '">' ~ site_name|e ~ '</a>'}, 'mail')|raw }}</p>
                        <p>{{ 'global.licence'|trans({'year': 'now'|date('Y')}, 'global')|raw }}</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
{% endapply %}
