{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["assets/*"],
      "@ui": ["assets/vue/Components/Admin/Ui/index.ts"],
      "@admin/*": ["assets/overwrite/vue/Components/Admin/*", "assets/vue/Components/Admin/*"],
      "@tests/*": ["tests/js/*"]
    }
  },
  "include": [
    "assets/**/*.ts",
    "assets/**/*.d.ts",
    "assets/**/*.tsx",
    "assets/**/*.vue",
    "assets/**/*.js"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}